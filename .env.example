# 阿里云百炼（DashScope）OpenAI 兼容端点
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4.1-flash

# 数据库
DB_URL=jdbc:postgresql://localhost:5433/insight
# 运行时账号：业务表只读 + trace 三表可写（见 V6__readonly_role.sql）
DB_USER=insight_ro
DB_PASSWORD=insight_ro
# 迁移用 owner 账号（建表、建角色）
DB_OWNER_USER=insight
DB_OWNER_PASSWORD=insight
